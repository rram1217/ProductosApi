@page "/ProductoCreate"
@using ProductoFront.Services
@using ProductoFront.Models
@inject ProductoService ProductoService
@inject NavigationManager Navigation

<PageTitle>Crear Producto</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-plus-circle"></i> Crear Nuevo Producto
                    </h3>
                </div>
                <div class="card-body">
                    <EditForm Model="@producto" OnValidSubmit="GuardarProducto">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="Nombre" class="form-label fw-bold">Nombre</label>
                            <InputText id="nombre"
                                       class="form-control"
                                       @bind-Value="producto.Nombre"
                                       placeholder="Ingrese el Nombre de la Producto" />
                            <ValidationMessage For="@(() => producto.Nombre)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label for="Descripcion" class="form-label fw-bold">Descripcion</label>
                            <InputText id="descripcion"
                                       class="form-control"
                                       @bind-Value="producto.Descripcion"
                                       placeholder="Ingrese el Nombre de la Producto" />
                            <ValidationMessage For="@(() => producto.Descripcion)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label for="Precio" class="form-label fw-bold">Precio</label>
                            <InputNumber id="precio"
                                       class="form-control"
                                       @bind-Value="producto.Precio"
                                       placeholder="Ingrese el precio del Producto" />
                            <ValidationMessage For="@(() => producto.Precio)" class="text-danger" />
                        </div>

                        @* <input type="hidden" name="FechaCreacion" value="@producto.Id" /> *@
                        <input type="hidden" name="FechaCreacion" value="@producto.FechaCreacion" />

@* 
                        <div class="mb-3">
                            <label for="Descripcion" class="form-label fw-bold">Descripción</label>
                            <InputTexProducto id="descripcion"
                                           class="form-control"
                                           rows="5"
                                           @bind-Value="producto.Descripcion"
                                           placeholder="Ingrese la descripción de la Producto" />
                            <ValidationMessage For="@(() => producto.Descripcion)" class="text-danger" />
                        </div>
 *@

                        <div class="mb-4">
                            <div class="form-check">
                                <InputCheckbox id="Estado"
                                               class="form-check-input"
                                               @bind-Value="producto.Estado" />
                                <label class="form-check-label" for="Estado">
                                    Estado
                                </label>
                            </div>
                        </div>

                        @if (mostrarMensaje)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle"></i> ¡Producto creada exitosamente!
                                <button type="button" class="btn-close" @onclick="@(() => mostrarMensaje = false)"></button>
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Guardar Producto
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="IrALista">
                                <i class="bi bi-list-ul"></i> Ver Lista de Productos
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFormulario">
                                <i class="bi bi-x-circle"></i> Limpiar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Producto producto = new();
    private bool mostrarMensaje = false;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool guardando = false;


    private async Task GuardarProducto()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        // Validaciones
        if (string.IsNullOrWhiteSpace(producto.Nombre))
        {
            mensajeError = "El Nombre es requerido";
            return;
        }

        if (string.IsNullOrWhiteSpace(producto.Descripcion))
        {
            mensajeError = "La Descripcion es requerida";
            return;
        }

        if (producto.Precio<0)
        {
            mensajeError = "El precio es requerido";
            return;
        }

        guardando = true;

        try
        {
            var resultado = await ProductoService.Crear(producto);

            if (resultado)
            {
                mensajeExito = "Producto guardada exitosamente";
                LimpiarFormulario();
            }
            else
            {
                mensajeError = "Error al guardar la Producto. Por favor intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void LimpiarFormulario()
    {
        producto = new Producto();
        mostrarMensaje = false;
    }

    private void IrALista()
    {
        Navigation.NavigateTo("/productoList");
    }
}
