@page "/ProductoCreate"
@rendermode InteractiveServer
@using ProductoFront.Models
@using ProductoFront.Services
@inject ProductoService ProductoService
@inject NavigationManager Navigation

<PageTitle>Registrar Producto</PageTitle>

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-person-plus-fill"></i> Registrar Nuevo Producto
            </h3>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i> @mensajeError
                    <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(mensajeExito))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @mensajeExito
                    <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
                </div>
            }

            <EditForm Model="@nuevoProducto" OnValidSubmit="GuardarProducto">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="Nombre" class="form-label fw-bold">
                        <i class="bi bi-person"></i> Nombre:
                    </label>
                    <InputText id="Nombre"
                               class="form-control"
                               @bind-Value="nuevoProducto.Nombre"
                               placeholder="Ingrese el Nombre completo"
                               maxlength="100" />
                    <ValidationMessage For="@(() => nuevoProducto.Nombre)" />
                </div>

                <div class="mb-3">
                    <label for="Descripcion" class="form-label fw-bold">
                        <i class="bi bi-person"></i> Descripcion:
                    </label>
                    <InputText id="Descripcion"
                               class="form-control"
                               @bind-Value="nuevoProducto.Descripcion"
                               placeholder="Ingrese la Descripcion"
                               maxlength="100" />
                    <ValidationMessage For="@(() => nuevoProducto.Descripcion)" />
                </div>

                <div class="mb-3">
                    <label for="Precio" class="form-label fw-bold">
                        <i class="bi bi-person"></i> Precio:
                    </label>
                    <InputNumber id="Precio"
                               class="form-control"
                               @bind-Value="nuevoProducto.Precio"
                               placeholder="Ingrese el Precio"
                               TValue="decimal"
                               maxlength="100" />
                    <ValidationMessage For="@(() => nuevoProducto.Precio)" />
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <InputCheckbox id="Estado"
                                       class="form-check-input"
                                       @bind-Value="nuevoProducto.Estado" />
                        <label class="form-check-label" for="Estado">
                            Estado
                        </label>
                    </div>
                </div>


                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <text>Guardando...</text>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                            <text> Guardar Producto</text>
                        }
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="LimpiarFormulario">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </button>
                    <button type="button" class="btn btn-info" @onclick="IrAConsulta">
                        <i class="bi bi-list-ul"></i> Ver Productos
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ProductoRequest nuevoProducto = new();
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool guardando = false;

    private async Task GuardarProducto()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        // Validaciones
        if (string.IsNullOrWhiteSpace(nuevoProducto.Nombre))
        {
            mensajeError = "El Nombre es requerido";
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevoProducto.Descripcion))
        {
            mensajeError = "La Descripcion es requerida";
            return;
        }

        if (nuevoProducto.FechaCreacion > DateTime.Today)
        {
            mensajeError = "La fecha de nacimiento no puede ser futura";
            return;
        }

        guardando = true;

        try
        {
            var resultado = await ProductoService.Crear(nuevoProducto);

            if (resultado)
            {
                mensajeExito = "Producto guardado exitosamente";
                LimpiarFormulario();
            }
            else
            {
                mensajeError = "Error al guardar el Producto. Por favor intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void LimpiarFormulario()
    {
        nuevoProducto = new ProductoRequest { FechaCreacion = DateTime.Today };
    }

    private void IrAConsulta()
    {
        Navigation.NavigateTo("/ProductoList");
    }
}